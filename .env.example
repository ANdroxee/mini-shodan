# Réseau à surveiller (notation CIDR)
SCAN_TARGET=192.168.1.0/24
# Fréquence des vérifications (cron) : tous les jours à 3 h
SCAN_SCHEDULE=0 3 * * *
# Autres exemples : @every 30m · 0 */6 * * *
# Fuseau horaire du planning
SCAN_TIMEZONE=Europe/Paris
WORKERS=10
# Change ce mot de passe avant le premier lancement
POSTGRES_PASSWORD=shodan123
